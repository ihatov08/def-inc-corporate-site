---
import { site, company, nav } from '../data/site';
import Logo from './Logo.astro';
const year = 2026; // 更新時に見直し
---

<footer class="border-t border-line bg-surface-subtle pt-[clamp(3rem,6vw,4.5rem)]">
  <div class="container-x grid grid-cols-[1.5fr_1fr] gap-10 pb-10 max-[700px]:grid-cols-1 max-[700px]:gap-7">
    <div>
      <a href="/" class="inline-block text-ink" aria-label={`${site.brand} トップ`}>
        <Logo class="h-[25px] w-auto" />
      </a>
      <p class="mt-3.5 mb-1 text-ink-muted">{site.catch}</p>
      <p class="m-0 text-sm text-ink-faint">
        〒{company.postalCode}<br />{company.address}
      </p>
    </div>

    <nav aria-label="フッターナビゲーション">
      <p class="mb-3 font-en text-[0.78rem] uppercase tracking-[0.16em] text-ink-faint">Menu</p>
      <ul class="grid list-none gap-2.5 p-0 m-0">
        {nav.map((item) => (
          <li><a class="text-[0.95rem] text-ink-muted hover:text-brand" href={item.href}>{item.label}</a></li>
        ))}
        <li><a class="text-[0.95rem] text-ink-muted hover:text-brand" href="/sales-email-policy">営業連絡に関するポリシー</a></li>
      </ul>
    </nav>
  </div>

  <div class="container-x flex items-center justify-between border-t border-line py-5.5 text-ink-faint max-[500px]:flex-col max-[500px]:gap-1.5">
    <small>© {site.copyrightSince}–{year} {site.name}</small>
    <small class="font-en">{site.domain}</small>
  </div>
</footer>
