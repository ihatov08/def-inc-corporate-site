---
import type { Course } from '../data/publications';
interface Props { course: Course }
const { course: c } = Astro.props;
---

<a
  href={c.link}
  target="_blank"
  rel="noopener"
  class="reveal group flex flex-col rounded-[var(--radius-card)] border border-line bg-surface-elevated transition-colors duration-200 hover:border-brand"
>
  <div
    class="relative flex h-32 items-end justify-between overflow-hidden rounded-t-[var(--radius-card)] p-3 text-white"
    style={c.image ? undefined : `background: ${c.accent ?? 'var(--color-brand)'};`}
  >
    {c.image && (
      <img
        src={c.image}
        alt={`${c.title} のサムネイル`}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
    )}
    {c.image && <span class="absolute inset-0 bg-linear-to-t from-black/55 to-transparent"></span>}
    <span class="relative rounded-[2px] border border-white/40 bg-black/20 px-2 py-0.5 font-en text-[0.7rem] font-medium">{c.category}</span>
    <span class="relative font-en text-xs font-semibold opacity-90">{c.platform ?? 'Udemy'}</span>
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-sm font-bold leading-snug text-ink transition-colors group-hover:text-brand line-clamp-4">{c.title}</h3>
    <span class="mt-3 inline-flex items-center gap-1 font-en text-xs font-medium text-brand">
      コースを見る
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="transition-transform duration-200 group-hover:translate-x-1"><path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>
</a>
