---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません">
  <section class="grid min-h-[60vh] place-items-center py-24">
    <div class="container-x text-center">
      <p class="font-en text-7xl font-bold text-brand/30">404</p>
      <h1 class="mt-2 text-2xl font-bold text-ink">ページが見つかりません</h1>
      <p class="mt-3 text-ink-muted">お探しのページは移動または削除された可能性があります。</p>
      <a class="btn btn-primary mt-6" href="/">トップページへ戻る</a>
    </div>
  </section>
</BaseLayout>
