---
import BaseLayout from '../layouts/BaseLayout.astro';

const updated = '2026-05-18';

const articles = [
  {
    title: '第1条（方針）',
    body: ['本フォームは、お客様からのお問い合わせを受け付けるための専用窓口です。当社は開発・運用業務に集中するため、無断の営業連絡をお断りしています。営業目的の送信にはお返事いたしません。'],
  },
  {
    title: '第2条（営業連絡の定義）',
    body: ['本ポリシーにおいて「営業連絡」とは、送信者（またはその所属組織）の商品・サービス・人材・コンテンツ等を、当社に対して購入・利用・受託・採用・提携等の形で受領するよう促す連絡をいいます。具体的には、次のような連絡が該当します。'],
    list: [
      '営業・勧誘・広告掲載のご案内',
      'SEO対策・リスティング広告運用・Web制作等の代行サービスのご提案',
      '人材紹介・採用支援・業務委託・営業代行のご提案',
      'M&A仲介・システム提案・各種ソリューションのご提案',
      'その他、自社の商品・サービス等の購入・利用・提携を促す内容を含む連絡',
    ],
  },
  {
    title: '第3条（お問い合わせフォーム利用時のお願い）',
    body: ['本フォームをご利用の際は、次の点にご協力ください。'],
    list: [
      '営業目的の送信はご遠慮ください。',
      'フォーム内の必須項目「本問い合わせは営業・勧誘目的ではありません」には、正確にご回答ください。営業・勧誘を目的とする送信の場合は「いいえ」をお選びください。',
      '「はい」を選択しながら営業連絡を送信された場合、その回答内容と矛盾する送信として取り扱い、お返事はいたしません。',
    ],
  },
  {
    title: '第4条（公表メールアドレス宛ての送信）',
    body: ['公表メールアドレスは、業務上必要な連絡（取材、採用応募、既存のお取引先からのご連絡、公務連絡、協業のご相談等）を受け付けるために公開しているものです。本フォームを経由せず公表メールアドレス宛てに送信された営業連絡についても、本フォーム経由の場合と同様にお断りし、お返事はいたしません。'],
  },
  {
    title: '第5条（無断営業連絡への対応）',
    body: ['無断の営業連絡を受信した場合、当社は次の対応をとることがあります。'],
    list: [
      '当該連絡への返信を行わないこと',
      '当該送信者のメールアドレスおよびドメインからの受信を拒否すること',
      '悪質・反復的な送信について、関連法令（特定電子メールの送信の適正化等に関する法律等）に基づき必要な措置を検討すること',
    ],
  },
  {
    title: '第6条（適用除外）',
    body: ['以下の連絡は、営業連絡には該当しないものとして取り扱います。'],
    list: [
      '報道機関等によるメディア取材・講演依頼',
      '当社が募集している人材・委託先への応募・推薦',
      '当社と既にお取引のある法人・個人からの業務上のご連絡',
      '国・地方公共団体・公益法人等からの公務目的のご連絡',
      '当社の事業内容に具体的に言及し、当社を個別の宛先として作成された協業・提携のご相談',
    ],
  },
  {
    title: '第7条（個人情報の取扱い）',
    body: ['営業連絡の受信に伴って取得した個人情報を含む、お問い合わせを通じて取得した個人情報の取扱いは、当社のプライバシーポリシーに従います。'],
  },
  {
    title: '第8条（本ポリシーの変更）',
    body: ['当社は、本ポリシーを必要に応じて変更することがあります。変更後の内容は、本サイトに掲載した時点から適用されるものとします。'],
  },
];
---

<BaseLayout
  title="営業目的のご連絡に関するポリシー"
  description="def合同会社の営業目的のご連絡に関するポリシー。お問い合わせフォームおよび公表メールアドレス宛ての営業目的の連絡の取扱いについて定めます。"
>
  <section class="py-[clamp(3rem,7vw,5rem)]">
    <div class="container-x max-w-3xl">
      <h1 class="text-[clamp(1.7rem,4vw,2.5rem)] font-bold text-ink">営業目的のご連絡に関するポリシー</h1>
      <p class="mt-2 text-sm text-ink-faint">最終更新日: {updated}</p>

      <p class="mt-6 rounded-r-lg border-l-4 border-brand bg-surface-subtle px-5 py-4 text-ink-muted">
        本ポリシーは、def合同会社（以下「当社」といいます）への営業・勧誘等を目的とした連絡（以下「営業連絡」といいます）の取扱いについて定めるものです。本ポリシーは、当社が運営するウェブサイト de-f.net 上のお問い合わせフォーム（以下「本フォーム」といいます）から送信された連絡と、当社が公開しているメールアドレス（以下「公表メールアドレス」といいます）宛てに送信された連絡の双方に適用されます。
      </p>

      <div class="mt-8 grid gap-8">
        {articles.map((a) => (
          <section>
            <h2 class="text-lg font-bold text-ink">{a.title}</h2>
            {a.body.map((p) => (<p class="mt-2 mb-0 text-ink-muted">{p}</p>))}
            {a.list && (
              <ul class="mt-3 grid list-disc gap-1.5 pl-5 text-ink-muted marker:text-brand">
                {a.list.map((li) => (<li>{li}</li>))}
              </ul>
            )}
          </section>
        ))}
      </div>

      <div class="mt-12 border-t border-line pt-8 text-center">
        <a class="btn btn-ghost" href="/">トップページへ戻る</a>
      </div>
    </div>
  </section>
</BaseLayout>
