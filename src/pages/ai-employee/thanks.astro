---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="お問い合わせありがとうございます" description="AI社員に関するお問い合わせを受け付けました。">
  <section class="min-h-[60vh] bg-surface-subtle">
    <div class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="eyebrow">Thank you</p>
      <h1 class="mt-3 text-[clamp(2rem,5vw,3.2rem)] font-bold text-ink">お問い合わせありがとうございます。</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-ink-muted">
        内容を確認のうえ、担当者からご連絡します。しばらくお待ちください。
      </p>
      <a class="btn btn-primary mt-8" href="/ai-employee">AI社員のページへ戻る</a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  if (typeof window.fbq === 'function') window.fbq('track', 'Lead');
</script>
