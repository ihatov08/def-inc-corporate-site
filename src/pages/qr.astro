---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, company } from '../data/site';

// 名刺などのQRコードから読み込まれるリンク集ページ。スマホで開かれる前提。
const links = [
  {
    label: 'Corporate Site',
    title: '会社ホームページ',
    description: 'def合同会社のサービス・会社概要',
    href: '/',
    external: false,
  },
  {
    label: 'Works',
    title: '開発実績',
    description: 'Webシステム・スマートフォンアプリの受託開発事例',
    href: '/works',
    external: false,
  },
  {
    label: 'Blog',
    title: 'ブログ',
    description: `${company.representative}の技術ブログ`,
    href: site.blogUrl,
    external: true,
  },
] as const;
---

<BaseLayout
  title="リンク集"
  description="def合同会社の会社ホームページとブログへのリンク集です。"
>
  <section class="py-[clamp(3rem,8vw,5rem)]">
    <div class="container-x max-w-xl!">
      <p class="eyebrow">Links</p>
      <h1 class="mt-3 text-[clamp(1.7rem,6vw,2.4rem)] font-bold text-ink">{site.brand}</h1>
      <p class="mt-3 text-ink-muted">{site.name}の各サイトへのリンクです。</p>

      <ul class="mt-8 grid gap-3">
        {
          links.map((link) => (
            <li>
              <a
                class="group flex items-center gap-4 rounded-card border border-line bg-surface-elevated p-5 shadow-soft transition-colors hover:border-brand max-sm:p-4"
                href={link.href}
                {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <span class="min-w-0 flex-1">
                  <span class="font-en text-[0.72rem] font-medium tracking-[0.12em] text-ink-faint uppercase">
                    {link.label}
                  </span>
                  <span class="mt-1 block font-bold text-ink group-hover:text-brand">{link.title}</span>
                  <span class="mt-0.5 block text-sm text-ink-muted">{link.description}</span>
                </span>
                <svg
                  class="shrink-0 text-ink-faint group-hover:text-brand"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  {link.external ? (
                    <path
                      d="M7 17 17 7M8 7h9v9"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  ) : (
                    <path
                      d="m9 6 6 6-6 6"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  )}
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-8 text-sm text-ink-muted">
        お問い合わせは
        <a class="text-brand underline underline-offset-2" href="/contact">お問い合わせページ</a>
        から承っています。
      </p>
    </div>
  </section>
</BaseLayout>
