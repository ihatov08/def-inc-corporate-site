---
import AIEmployeeAvatar from '../components/AIEmployeeAvatar';

const worries = [
  ['人手不足', '採用したくても人が来ない。既存社員に仕事が集中している。'],
  ['属人化', '担当者に聞かないと分からない。過去の資料が活かされていない。'],
  ['AI活用', 'ChatGPTは試した。でも、会社の仕事にはまだつながっていない。'],
];

const examples = [
  ['営業の下調べ', '過去の提案書や商品資料をもとに、提案のたたき台を作る'],
  ['社内の問い合わせ', '社内規程・マニュアルをもとに、よくある質問へ回答する'],
  ['報告書づくり', 'メモや音声から、日報・議事録・作業報告を整える'],
];

const buildExamples: [string, string, string, string[], string[][]][] = [
  ['営業AI', '提案書の下書き', '過去の提案書・商品資料から、次の提案を整理', ['#5b35e8', '#ffb43b', '#ff6b8a', '#1f2937', '#f7f8fc'], [['Google Drive', 'https://api.iconify.design/logos/google-drive.svg'], ['Google Sheets', 'https://api.iconify.design/thesvg-color/google-sheets.svg']]],
  ['総務AI', '社内質問への回答', '就業規則・社内ルールから、回答の候補を提示', ['#159a9c', '#bdeff0', '#ffcf56', '#273444', '#f7f8fc'], [['Notion', 'https://api.iconify.design/logos/notion-icon.svg'], ['Slack', 'https://api.iconify.design/logos/slack-icon.svg']]],
  ['採用AI', '応募者への案内文', '募集内容や会社情報をもとに、連絡文を作成', ['#e95686', '#ffc2d9', '#5b35e8', '#2f3140', '#fff7fb'], [['Gmail', 'https://api.iconify.design/logos/google-gmail.svg'], ['Google Calendar', 'https://api.iconify.design/logos/google-calendar.svg']]],
  ['現場AI', '作業報告の整理', '現場メモや写真の内容から、報告書の下書きを作成', ['#36a269', '#b9ebc9', '#ffb43b', '#243b35', '#f7f8fc'], [['Dropbox', 'https://api.iconify.design/logos/dropbox.svg'], ['Google Drive', 'https://api.iconify.design/logos/google-drive.svg']]],
  ['経理AI', '請求書の確認補助', '請求内容を整理し、確認が必要な項目を一覧化', ['#d88b00', '#ffe08a', '#ff6b4a', '#31323a', '#fffaf0'], [['Google Sheets', 'https://api.iconify.design/thesvg-color/google-sheets.svg'], ['Stripe', 'https://api.iconify.design/logos/stripe.svg']]],
  ['広報AI', '発信内容の下書き', '社内の出来事やサービス情報を、発信用に整える', ['#7561d8', '#d8d0ff', '#ff7895', '#2f3140', '#faf9ff'], [['Figma', 'https://api.iconify.design/logos/figma.svg'], ['Slack', 'https://api.iconify.design/logos/slack-icon.svg']]],
];

const saasExamples = [
  ['Google Workspace', 'https://api.iconify.design/logos/google-drive.svg', 'G'],
  ['Gmail', 'https://api.iconify.design/logos/google-gmail.svg', 'G'],
  ['Google Sheets', 'https://api.iconify.design/thesvg-color/google-sheets.svg', 'S'],
  ['Google Calendar', 'https://api.iconify.design/logos/google-calendar.svg', 'C'],
  ['Microsoft 365', 'https://api.iconify.design/logos/microsoft-icon.svg', 'M'],
  ['Slack', 'https://api.iconify.design/logos/slack-icon.svg', 'S'],
  ['LINE WORKS', 'https://api.iconify.design/thesvg-color/line.svg', 'L'],
  ['Discord', 'https://api.iconify.design/logos/discord-icon.svg', 'D'],
  ['Notion', 'https://api.iconify.design/logos/notion-icon.svg', 'N'],
  ['Miro', 'https://api.iconify.design/logos/miro.svg', 'M'],
  ['Figma', 'https://api.iconify.design/logos/figma.svg', 'F'],
  ['Dropbox', 'https://api.iconify.design/logos/dropbox.svg', 'D'],
  ['Box', 'https://api.iconify.design/logos/box.svg', 'B'],
  ['Zoom', 'https://api.iconify.design/logos/zoom-icon.svg', 'Z'],
  ['GitHub', 'https://api.iconify.design/logos/github-icon.svg', 'G'],
  ['GitLab', 'https://api.iconify.design/logos/gitlab.svg', 'G'],
  ['Jira', 'https://api.iconify.design/logos/jira.svg', 'J'],
  ['Trello', 'https://api.iconify.design/logos/trello.svg', 'T'],
  ['Asana', 'https://api.iconify.design/logos/asana.svg', 'A'],
  ['Salesforce', 'https://api.iconify.design/logos/salesforce.svg', 'S'],
  ['HubSpot', 'https://api.iconify.design/logos/hubspot.svg', 'H'],
  ['Zendesk', 'https://api.iconify.design/logos/zendesk.svg', 'Z'],
  ['Shopify', 'https://api.iconify.design/logos/shopify.svg', 'S'],
  ['Stripe', 'https://api.iconify.design/logos/stripe.svg', 'S'],
];

const steps = [
  ['01', '無料相談', '困っている業務をひとつだけお聞かせください。AIの知識は不要です。'],
  ['02', '業務を整理', '仕事の流れと、AIに任せる範囲を一緒に決めます。'],
  ['03', '一人目をつくる', '御社の資料やルールに合わせた、最初のAI社員を試作します。'],
  ['04', '使いながら育てる', '現場で使い、回答や仕事ぶりを見ながら改善します。'],
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>御社だけのAI社員｜岩手県の企業向け</title>
    <meta name="description" content="岩手県の企業向け。御社の業務と資料を理解する、御社だけのAI社員をつくりませんか。今なら一人目のAI社員の構築を無料でご相談いただけます。" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;500;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
  <div class="ai-lp">
    <section class="ai-hero">
      <div class="ai-wrap ai-hero-grid">
        <div>
          <p class="ai-kicker ai-hero-question">AI活用、ChatGPTだけで<br class="mobile-only" /><span class="hero-nowrap">止まっていませんか？</span></p>
          <h1>御社の仕事を、<br /><span>ひとつAIに任せてみる。</span></h1>
          <p class="ai-hero-lead">採用が難しい仕事、担当者に集中している仕事、毎回くり返す仕事。<br class="desktop-only" />御社の業務に合わせたAIの使い方を、一緒に考えます。</p>
          <div class="ai-offer"><span>無料構築のご案内</span><strong>一人目のAI社員、<b>構築費0円。</b></strong><small>御社の業務に合わせた最初の1人を、無料でつくります。</small></div>
          <div class="ai-actions"><a class="ai-button ai-button-dark" href="/contact">無料で相談する <span>→</span></a><a class="ai-text-link" href="#what">AI社員とは？</a></div>
          <p class="ai-note">岩手県内・オンライン対応　／　無理な営業は行いません</p>
        </div>
      </div>
    </section>

    <section class="ai-section ai-cream" id="what">
      <div class="ai-wrap">
        <p class="ai-kicker">AI社員とは</p>
        <div class="ai-heading-row"><h2>万能なロボットではありません。<br /><em>御社の仕事を手伝う、専属の相棒</em>です。</h2><p>ChatGPTをそのまま渡すのではなく、御社の資料・仕事の流れ・言葉づかいに合わせて、役割をひとつ決めます。</p></div>
        <div class="ai-three"><div><b>知っている</b><strong>御社の資料・ルール</strong><span>必要な情報を探し、回答の根拠にする</span></div><div><b>できる</b><strong>決めた仕事を手伝う</strong><span>下書き、整理、検索、報告を軽くする</span></div><div><b>育てられる</b><strong>使うほど御社向けに</strong><span>現場の声をもとに改善していく</span></div></div>
        <div class="ai-flow" aria-label="AI社員が仕事を手伝う流れ"><div class="ai-flow-step ai-flow-input"><span>01</span><strong>御社の情報</strong><small>資料・ルール<br />過去の事例</small></div><b class="ai-flow-arrow">→</b><div class="ai-flow-step ai-flow-core"><span>02</span><strong>御社のAI社員</strong><small>決めた役割に沿って<br />情報を整理・判断</small></div><b class="ai-flow-arrow">→</b><div class="ai-flow-step ai-flow-output"><span>03</span><strong>仕事の下書き</strong><small>報告書・回答・提案<br />人が確認して完成</small></div></div>
      </div>
    </section>

    <section class="ai-section" id="worries"><div class="ai-wrap"><div class="ai-heading-row"><div><p class="ai-kicker">こんな会社へ</p><h2>個人の工夫を、<br />会社の仕事につなげる。</h2></div><p>ChatGPTを個人が便利に使う段階から、会社の仕事で使う段階へ。まずは、時間を取られている業務をひとつ見つけます。</p></div><div class="ai-worry-grid">{worries.map((item, i) => <article><span>0{i + 1}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></div></section>

    <section class="ai-section ai-builds"><div class="ai-wrap"><div class="ai-heading-row"><div><p class="ai-kicker">構築例（イメージ）</p><h2>自分だけのAIチームを<br /><em>つくろう。</em></h2></div><p>同じAIを全社に配るのではなく、業務ごとに役割を持たせます。下記は構築できる役割の一例です。</p></div><div class="ai-build-grid">{buildExamples.map((item, i) => <article><div class="ai-build-avatar"><AIEmployeeAvatar name={item[0]} colors={item[3]} /></div><div class="ai-build-label"><span>0{i + 1}</span><b>{item[0]}</b></div><h3>{item[1]}</h3><p>{item[2]}</p><div class="ai-build-tools" aria-label={`${item[0]}で使うSaaS`}>{item[4].map((tool) => <span title={tool[0]}><img src={tool[1]} alt={`${tool[0]}のロゴ`} /></span>)}</div></article>)}</div></div></section>

    <section class="ai-section ai-integrations"><div class="ai-wrap"><div class="ai-integration-panel"><div class="ai-integration-copy"><p class="ai-kicker">SaaS連携</p><h2>国内外の<br />SaaSと連携できます。</h2><p>いま使っているツールを置き換えるのではなく、御社の業務に必要な範囲でつなぎます。</p></div><div class="ai-saas-cloud" aria-label="連携先の例">{saasExamples.map((service, i) => <span class={`ai-saas-pill ai-saas-${(i % 8) + 1}`}><i><img src={service[1]} alt={`${service[0]}のロゴ`} loading="lazy" /></i>{service[0]}</span>)}</div><span class="ai-integration-shape ai-shape-one" aria-hidden="true"></span><span class="ai-integration-shape ai-shape-two" aria-hidden="true"></span></div><p class="ai-integration-note">連携先の例です。ご利用中のサービスを確認して、対応可否と連携方法を設計します。</p></div></section>

    <section class="ai-section ai-automation"><div class="ai-wrap ai-automation-layout"><div class="ai-automation-copy"><p class="ai-kicker">AI社員の役割</p><h2>ひとつのAI社員が、<br /><em>仕事の流れをつなぐ。</em></h2><p>資料を読み、決めたルールで考え、必要なツールを動かす。人が確認するところまでを、御社の仕事に合わせて設計します。</p></div><div class="ai-automation-diagram" aria-label="AI社員が仕事の流れをつなぐ図"><div class="ai-orbit ai-orbit-top"><b>考える・判断する</b><span>資料やルールをもとに<br />次の動きを整理</span></div><div class="ai-orbit ai-orbit-right"><b>ツールを動かす</b><span>メール・表計算・<br />社内サービスと連携</span></div><div class="ai-orbit ai-orbit-bottom"><b>人に確認する</b><span>下書きを渡して<br />最後は人が判断</span></div><div class="ai-orbit ai-orbit-left"><b>決まった流れ</b><span>繰り返す仕事を<br />いつもの手順で進める</span></div><div class="ai-automation-center"><div class="ai-automation-avatar"><AIEmployeeAvatar name="御社のAI社員" colors={['#5b35e8', '#9d7cff', '#ff83bb', '#292b3a', '#f8f7ff']} /></div><strong>御社の<br />AI社員</strong></div></div></div></section>

    <section class="ai-section ai-navy"><div class="ai-wrap"><p class="ai-kicker">できること</p><div class="ai-heading-row"><h2>「AIに任せたい」を、<br /><em>仕事の形</em>にします。</h2><p>役割を絞るから、使い始めやすい。業務に合わせて、できることを一緒に決めます。</p></div><div class="ai-example-list">{examples.map((item, i) => <div><span>0{i + 1}</span><div><h3>{item[0]}</h3><p>{item[1]}</p></div><b>↗</b></div>)}</div></div></section>

    <section class="ai-section"><div class="ai-wrap"><div class="ai-heading-row"><div><p class="ai-kicker">始め方</p><h2>最初から完璧を<br />目指さなくて大丈夫です。</h2></div><p>一人目のAI社員は、会社全体を変えるためではなく、効果が分かりやすい仕事から始めるための一歩です。</p></div><div class="ai-steps">{steps.map((step) => <div><span>{step[0]}</span><h3>{step[1]}</h3><p>{step[2]}</p></div>)}</div></div></section>

    <section class="ai-section ai-cream"><div class="ai-wrap ai-reason"><div><p class="ai-kicker">def合同会社について</p><h2>相談だけで終わらず、<br />必要なら実際につくれます。</h2></div><div><p>私たちは岩手県盛岡市を拠点に、Webシステムやアプリを開発してきた会社です。AIの使い方を説明するだけでなく、御社の業務に合わせた仕組みとして設計・開発・運用まで対応します。</p><p>「AIを使いたいけれど、何を頼めばいいか分からない」という段階からご相談ください。</p></div></div></section>

    <section class="ai-person"><div class="ai-wrap ai-person-inner"><div class="ai-person-photo"><img src="/images/representative.jpg" alt="def合同会社 代表 吉田智哉" /><span>代表</span></div><div><p class="ai-kicker">代表</p><h2>最初のご相談から、<br />吉田が直接お話を伺います。<small>代表 吉田 智哉</small></h2><p>岩手県盛岡市を拠点に、Webシステム・スマートフォンアプリの開発を行っています。技術書籍の執筆、オンライン講座、OSSへの貢献を通じて、開発の知見も発信しています。</p><p>AIの導入を決める前の「何から考えればいいか分からない」という相談から、業務に合わせた仕組みの設計・開発まで、直接お話を伺います。</p></div></div></section>

    <section class="ai-final"><div class="ai-wrap"><p class="ai-kicker">無料構築のご案内</p><h2>一人目のAI社員を、<br />無料でつくるところから。</h2><p>まずは、AIに任せたい仕事をひとつ教えてください。御社に合うかどうか、できること・難しいことを正直にお伝えします。</p><a class="ai-button ai-button-light" href="/contact">無料構築について相談する <span>→</span></a><small>無料の対象範囲や進め方は、相談時にご説明します。</small></div></section>
  </div>
  </body>
</html>

<style>
  :root { color-scheme:light; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:#fffdf8; }
  a { color:inherit; }
  .ai-lp { --ink:#25241f; --muted:#716f67; --cream:#f3f0e8; --paper:#fffdf8; --navy:#17323b; --orange:#d45b35; color:var(--ink); background:var(--paper); font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", YuGothic, sans-serif; }
  .ai-lp * { box-sizing:border-box; }
  .ai-wrap { max-width:1080px; margin:auto; padding:0 32px; }
  .ai-hero { background:var(--cream); overflow:hidden; }
  .ai-hero-grid { min-height:690px; display:grid; grid-template-columns:1.05fr .95fr; align-items:center; gap:40px; padding-top:80px; padding-bottom:80px; }
  .ai-kicker { margin:0 0 18px; color:var(--orange); font-size:12px; font-weight:700; letter-spacing:.14em; }
  .ai-hero h1 { margin:0; font-family:Georgia, "Times New Roman", serif; font-size:clamp(42px, 5.3vw, 76px); line-height:1.14; letter-spacing:-.055em; font-weight:700; }
  .ai-hero h1 span { color:var(--orange); }
  .ai-hero-lead { margin:28px 0 0; color:var(--muted); font-size:17px; line-height:2; }
  .ai-offer { margin-top:26px; padding:17px 20px; border-left:4px solid var(--orange); background:rgba(255,253,248,.76); }
  .ai-offer > span { display:block; color:var(--orange); font-size:11px; font-weight:800; letter-spacing:.08em; }
  .ai-offer strong { display:block; font-size:23px; }
  .ai-offer strong b { color:var(--orange); }
  .ai-offer small { display:block; margin-top:3px; color:var(--muted); font-size:12px; }
  .ai-actions { display:flex; align-items:center; gap:22px; margin-top:30px; }
  .ai-button { display:inline-flex; gap:18px; align-items:center; padding:16px 22px; font-size:14px; font-weight:700; text-decoration:none; transition:transform .2s, background .2s; }
  .ai-button:hover { transform:translateY(-2px); }
  .ai-button-dark { color:#fff; background:var(--navy); }
  .ai-button-light { color:var(--navy); background:#fff; }
  .ai-text-link { color:var(--ink); font-size:13px; text-decoration:underline; text-underline-offset:5px; }
  .ai-note { margin:16px 0 0; color:#89867e; font-size:11px; }
  .ai-visual { position:relative; width:min(100%,440px); margin-left:auto; }
  .ai-paper { padding:24px; border:1px solid #d9d4c8; background:#fff; box-shadow:18px 18px 0 #ded9cc; transform:rotate(2.2deg); }
  .ai-paper-top,.ai-paper-foot { display:flex; justify-content:space-between; color:#8d897f; font-size:10px; letter-spacing:.08em; }
  .ai-status { color:#56835f; }
  .ai-avatar { display:flex; align-items:center; gap:15px; margin:36px 0 28px; }
  .ai-avatar-face { display:grid; place-items:center; width:74px; height:74px; border-radius:50%; background:#e9c9ab; position:relative; }
  .ai-avatar-face:before { content:""; position:absolute; width:80px; height:33px; top:-6px; border-radius:50% 50% 40% 40%; background:#3d4b4b; }
  .ai-avatar-face i { width:7px; height:7px; border-radius:50%; background:#31312e; position:relative; margin:0 5px; }
  .ai-avatar-face b { position:absolute; width:22px; height:7px; border-bottom:2px solid #31312e; border-radius:50%; bottom:18px; }
  .ai-avatar span { font-family:Georgia,serif; font-size:21px; font-weight:700; }
  .ai-chat { border-top:1px solid #ece8df; border-bottom:1px solid #ece8df; padding:20px 0; font-size:12px; line-height:1.7; }
  .ai-chat p { margin:0; } .ai-chat b { color:var(--orange); } .ai-chat .ai-reply { margin-top:17px; padding:12px; background:#f4f1e9; }
  .ai-paper-foot { margin-top:20px; justify-content:flex-start; gap:10px; } .ai-paper-foot span { padding:5px 8px; border:1px solid #ddd8cc; }
  .ai-stamp { position:absolute; right:-20px; bottom:-30px; display:grid; place-items:center; width:86px; height:86px; border:2px solid var(--orange); border-radius:50%; color:var(--orange); font-family:Georgia,serif; font-size:18px; line-height:1; text-align:center; transform:rotate(-12deg); } .ai-stamp small { font:700 9px sans-serif; letter-spacing:.15em; }
  .ai-section { padding:110px 0; } .ai-cream { background:var(--cream); } .ai-navy { color:#f5f1e8; background:var(--navy); } .ai-navy .ai-kicker { color:#ef9b78; }
  .ai-heading-row { display:grid; grid-template-columns:1fr .72fr; gap:60px; align-items:end; } .ai-heading-row h2,.ai-final h2 { margin:0; font-family:Georgia,"Times New Roman",serif; font-size:clamp(32px,4vw,52px); line-height:1.3; letter-spacing:-.04em; } .ai-heading-row h2 em { color:var(--orange); font-style:normal; } .ai-heading-row > p { margin:0; color:var(--muted); line-height:2; font-size:14px; } .ai-navy .ai-heading-row > p { color:#b9c3c1; }
  .ai-three { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; margin-top:65px; background:#d8d4cb; border:1px solid #d8d4cb; } .ai-three > div { padding:29px; background:var(--paper); } .ai-three b { display:block; color:var(--orange); font-size:11px; } .ai-three strong { display:block; margin-top:30px; font-family:Georgia,serif; font-size:21px; } .ai-three span { display:block; margin-top:12px; color:var(--muted); font-size:12px; line-height:1.8; }
  .ai-worry-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:58px; } .ai-worry-grid article { padding:28px 24px; border:1px solid #e3dfd5; background:#fff; } .ai-worry-grid span,.ai-example-list > div > span,.ai-steps span { color:var(--orange); font-family:Georgia,serif; font-size:14px; } .ai-worry-grid h3 { margin:35px 0 10px; font-family:Georgia,serif; font-size:24px; } .ai-worry-grid p,.ai-example-list p,.ai-steps p { margin:0; color:var(--muted); font-size:13px; line-height:1.9; }
