---
import AIEmployeeAvatar from '../components/AIEmployeeAvatar';

const worries = [
  ['人手不足', '採用したくても人が来ない。既存社員に仕事が集中している。'],
  ['属人化', '担当者に聞かないと分からない。過去の資料が活かされていない。'],
  ['AI活用', 'ChatGPTは試した。でも、会社の仕事にはまだつながっていない。'],
];

const examples = [
  ['営業の下調べ', '過去の提案書や商品資料をもとに、提案のたたき台を作る'],
  ['社内の問い合わせ', '社内規程・マニュアルをもとに、よくある質問へ回答する'],
  ['報告書づくり', 'メモや音声から、日報・議事録・作業報告を整える'],
];

const actionExamples = [
  ['✦', 'AIワーカー'], ['↗', 'アプリと連携する'], ['♙', '担当者へ対応を依頼する'], ['♡', '承認を依頼する'],
  ['▤', 'データベースを操作する'], ['✉', 'メールを送る'], ['▧', '書類を発行する'], ['▥', 'フォーム'],
  ['▱', 'ブラウザ操作'], ['◫', '画像・PDFから文字を読み取る'], ['―', '要約する'], ['⇄', 'データを操作・変換する'],
  ['▧', 'テキスト抽出'], ['⌁', '音声データを文字起こしする'], ['あ', '翻訳する'], ['⌕', 'Web検索'],
];

const buildExamples: [string, string, string, string[], string[][]][] = [
  ['営業AI', '提案書の下書き', '過去の提案書・商品資料から、次の提案を整理', ['#5b35e8', '#ffb43b', '#ff6b8a', '#1f2937', '#f7f8fc'], [['Google Drive', '/icons/saas/google-drive.svg'], ['Google Sheets', '/icons/saas/google-sheets.svg']]],
  ['総務AI', '社内質問への回答', '就業規則・社内ルールから、回答の候補を提示', ['#159a9c', '#bdeff0', '#ffcf56', '#273444', '#f7f8fc'], [['Notion', '/icons/saas/notion-icon.svg'], ['Slack', '/icons/saas/slack-icon.svg']]],
  ['採用AI', '応募者への案内文', '募集内容や会社情報をもとに、連絡文を作成', ['#e95686', '#ffc2d9', '#5b35e8', '#2f3140', '#fff7fb'], [['Gmail', '/icons/saas/google-gmail.svg'], ['Google Calendar', '/icons/saas/google-calendar.svg']]],
  ['現場AI', '作業報告の整理', '現場メモや写真の内容から、報告書の下書きを作成', ['#36a269', '#b9ebc9', '#ffb43b', '#243b35', '#f7f8fc'], [['Dropbox', '/icons/saas/dropbox.svg'], ['Google Drive', '/icons/saas/google-drive.svg']]],
  ['経理AI', '請求書の確認補助', '請求内容を整理し、確認が必要な項目を一覧化', ['#d88b00', '#ffe08a', '#ff6b4a', '#31323a', '#fffaf0'], [['Google Sheets', '/icons/saas/google-sheets.svg'], ['Stripe', '/icons/saas/stripe.svg']]],
  ['広報AI', '発信内容の下書き', '社内の出来事やサービス情報を、発信用に整える', ['#7561d8', '#d8d0ff', '#ff7895', '#2f3140', '#faf9ff'], [['Figma', '/icons/saas/figma.svg'], ['Slack', '/icons/saas/slack-icon.svg']]],
];

const saasExamples = [
  ['Google Workspace', '/icons/saas/google-drive.svg', 'G'],
  ['Gmail', '/icons/saas/google-gmail.svg', 'G'],
  ['Google Sheets', '/icons/saas/google-sheets.svg', 'S'],
  ['Google Calendar', '/icons/saas/google-calendar.svg', 'C'],
  ['Microsoft 365', '/icons/saas/microsoft-icon.svg', 'M'],
  ['Slack', '/icons/saas/slack-icon.svg', 'S'],
  ['LINE WORKS', '/icons/saas/line.svg', 'L'],
  ['Discord', '/icons/saas/discord-icon.svg', 'D'],
  ['Notion', '/icons/saas/notion-icon.svg', 'N'],
  ['Miro', '/icons/saas/miro.svg', 'M'],
  ['Figma', '/icons/saas/figma.svg', 'F'],
  ['Dropbox', '/icons/saas/dropbox.svg', 'D'],
  ['Box', '/icons/saas/box.svg', 'B'],
  ['Zoom', '/icons/saas/zoom-icon.svg', 'Z'],
  ['GitHub', '/icons/saas/github-icon.svg', 'G'],
  ['GitLab', '/icons/saas/gitlab.svg', 'G'],
  ['Jira', '/icons/saas/jira.svg', 'J'],
  ['Trello', '/icons/saas/trello.svg', 'T'],
  ['Asana', '/icons/saas/asana.svg', 'A'],
  ['Salesforce', '/icons/saas/salesforce.svg', 'S'],
  ['HubSpot', '/icons/saas/hubspot.svg', 'H'],
  ['Zendesk', '/icons/saas/zendesk.svg', 'Z'],
  ['Shopify', '/icons/saas/shopify.svg', 'S'],
  ['Stripe', '/icons/saas/stripe.svg', 'S'],
];

const steps = [
  ['01', '無料相談', '困っている業務をひとつだけお聞かせください。AIの知識は不要です。'],
  ['02', '業務を整理', '仕事の流れと、AIに任せる範囲を一緒に決めます。'],
  ['03', '一人目をつくる', '御社の資料やルールに合わせた、最初のAI社員を試作します。'],
  ['04', '使いながら育てる', '現場で使い、回答や仕事ぶりを見ながら改善します。'],
