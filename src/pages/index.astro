---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import BookCard from '../components/BookCard.astro';
import CourseCard from '../components/CourseCard.astro';
import OssCard from '../components/OssCard.astro';
import { site } from '../data/site';
import { books, courses, ossContributions } from '../data/publications';

const works = (await getCollection('works', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const topBooks = books.slice(0, 4);
const topCourses = courses.slice(0, 3);
const topOss = ossContributions.slice(0, 3);

const services = [
  {
    title: 'Webアプリ開発',
    desc: '要件定義から設計・開発・運用まで一貫対応。スピーディーかつ保守性の高いWebアプリケーションを構築します。',
    icon: 'M4 5h16v11H4zM2 20h20M9 9l2 2-2 2m4 0h3',
  },
  {
    title: 'スマホアプリ開発',
    desc: 'iOS / Android 両対応。クロスプラットフォーム開発で、コストを抑えながら高品質なアプリを提供します。',
    icon: 'M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM10 18h4',
  },
  {
    title: '保守・運用',
    desc: 'リリースして終わりではなく、公開後の改善・機能追加・保守まで継続的に伴走します。',
    icon: 'M12 3v2m0 14v2m9-9h-2M5 12H3m14.5-6.5-1.4 1.4M7.9 16.1l-1.4 1.4m11 0-1.4-1.4M7.9 7.9 6.5 6.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative border-b border-line">
    <!-- 左端のシグナルライン（アクセント） -->
    <span class="pointer-events-none absolute left-0 top-0 h-full w-[3px] bg-brand" aria-hidden="true"></span>
    <div class="container-x flex min-h-[82vh] flex-col justify-center py-24">
      <p class="eyebrow reveal is-visible">{site.tagline}</p>
      <h1 class="reveal is-visible mt-5 max-w-4xl text-[clamp(2.2rem,6.5vw,4.4rem)] font-bold leading-[1.1] tracking-tight text-ink">
        課題を<span class="text-brand">定義</span>し、<br class="max-sm:hidden" />役に立つプロダクトへ。
      </h1>
      <p class="reveal is-visible mt-6 max-w-2xl text-lg text-ink-muted">
        {site.description}
      </p>
      <div class="reveal is-visible mt-9 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/works">開発実績を見る</a>
        <a class="btn btn-ghost" href="/contact">お問い合わせ</a>
      </div>

      <dl class="reveal mt-16 grid max-w-3xl grid-cols-3 border border-line max-sm:grid-cols-1">
        <div class="border-r border-line p-5 max-sm:border-b max-sm:border-r-0">
          <dt class="font-en text-3xl font-bold text-ink">2019</dt>
          <dd class="mt-1 font-en text-xs uppercase tracking-wider text-ink-muted">Since / 設立</dd>
        </div>
        <div class="border-r border-line p-5 max-sm:border-b max-sm:border-r-0">
          <dt class="font-en text-3xl font-bold text-ink">Web / App</dt>
          <dd class="mt-1 font-en text-xs uppercase tracking-wider text-ink-muted">両輪の開発体制</dd>
        </div>
        <div class="p-5">
          <dt class="font-en text-3xl font-bold text-ink">End-to-End</dt>
          <dd class="mt-1 font-en text-xs uppercase tracking-wider text-ink-muted">設計から運用まで</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- About -->
  <section class="py-[clamp(4rem,9vw,7rem)]">
    <div class="container-x grid grid-cols-[1fr_1.2fr] items-center gap-14 max-lg:grid-cols-1 max-lg:gap-8">
      <div class="reveal">
        <p class="eyebrow">About</p>
        <h2 class="mt-3 text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold text-ink">
          お客様のビジネスに、<br />ちゃんと役立つものを。
        </h2>
      </div>
      <div class="reveal text-ink-muted">
        <p>
          def合同会社は、岩手県八幡平市を拠点にWebシステム・スマートフォンアプリの開発を行っています。「def（define：定義する）」という社名のとおり、目の前の課題が本当は何なのかを一緒に定義するところから始めます。
        </p>
        <p class="mb-0">
          流行りの技術を使うこと自体が目的ではなく、市場のニーズに密着した、多くの人の役に立つサービスを届けること。それが私たちの変わらない指針です。
        </p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="border-y border-line bg-surface-subtle py-[clamp(4rem,9vw,7rem)]">
    <div class="container-x">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Services</p>
        <h2 class="mt-3 text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold text-ink">できること</h2>
        <p class="mt-3 text-ink-muted">Webからモバイルまで。企画・設計から開発・運用まで一貫してお任せいただけます。</p>
      </div>

      <div class="mt-12 grid grid-cols-3 gap-6 max-lg:grid-cols-1">
        {services.map((s) => (
          <div class="reveal rounded-[var(--radius-card)] border border-line bg-surface-elevated p-7 transition-colors duration-200 hover:border-brand">
            <div class="grid h-12 w-12 place-items-center rounded-[var(--radius-card)] border border-line text-brand">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d={s.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="mt-5 text-lg font-bold text-ink">{s.title}</h3>
            <p class="mt-2 mb-0 text-[0.93rem] text-ink-muted">{s.desc}</p>
          </div>
        ))}
      </div>

      <div class="reveal mt-9">
        <a class="btn btn-ghost" href="/services">サービス詳細へ</a>
      </div>
    </div>
  </section>

  <!-- Works -->
  <section class="py-[clamp(4rem,9vw,7rem)]">
    <div class="container-x">
      <div class="reveal flex items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Works</p>
          <h2 class="mt-3 text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold text-ink">開発実績</h2>
          <p class="mt-3 text-ink-muted">これまでに手がけたプロジェクトの一部をご紹介します。</p>
        </div>
        <a class="btn btn-ghost max-sm:hidden" href="/works">すべて見る</a>
      </div>

      {works.length > 0 ? (
        <div class="mt-12 grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-sm:grid-cols-1">
          {works.map((w) => (
            <WorkCard
              href={`/works/${w.id}`}
              title={w.data.title}
              summary={w.data.summary}
              category={w.data.category}
              tags={w.data.tags}
              accent={w.data.accent}
            />
          ))}
        </div>
      ) : (
        <p class="mt-10 text-ink-muted">実績は準備中です。</p>
      )}

      <div class="reveal mt-8 sm:hidden">
        <a class="btn btn-ghost" href="/works">すべて見る</a>
      </div>
    </div>
  </section>

  <!-- Publications -->
  <section class="border-t border-line bg-surface-subtle py-[clamp(4rem,9vw,7rem)]">
    <div class="container-x">
      <div class="reveal flex items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Publications</p>
          <h2 class="mt-3 text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold text-ink">出版実績</h2>
          <p class="mt-3 text-ink-muted">技術書籍の執筆を通じて、開発の知見を発信しています。</p>
        </div>
        <a class="btn btn-ghost max-sm:hidden" href="/publications">すべて見る</a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-5 max-sm:grid-cols-1">
        {topBooks.map((b) => (<BookCard book={b} />))}
      </div>
      <div class="reveal mt-8 sm:hidden">
        <a class="btn btn-ghost" href="/publications">すべて見る</a>
      </div>
    </div>
  </section>

  <!-- Courses -->
  <section class="py-[clamp(4rem,9vw,7rem)]">
    <div class="container-x">
      <div class="reveal flex items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Courses</p>
          <h2 class="mt-3 text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold text-ink">オンライン講座</h2>
          <p class="mt-3 text-ink-muted">Udemyで生成AI・Rails・Next.js・Docker・Linux などの講座を公開しています。</p>
        </div>
        <a class="btn btn-ghost max-sm:hidden" href="/courses">すべて見る</a>
      </div>
      <div class="mt-10 grid grid-cols-3 gap-5 max-lg:grid-cols-2 max-sm:grid-cols-1">
        {topCourses.map((c) => (<CourseCard course={c} />))}
      </div>
      <div class="reveal mt-8 sm:hidden">
        <a class="btn btn-ghost" href="/courses">すべて見る</a>
      </div>
    </div>
  </section>

  <!-- OSS -->
  <section class="border-t border-line bg-surface-subtle py-[clamp(4rem,9vw,7rem)]">
    <div class="container-x">
      <div class="reveal flex items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="eyebrow">Open Source</p>
          <h2 class="mt-3 text-[clamp(1.6rem,3.6vw,2.4rem)] font-bold text-ink">OSSコントリビュート</h2>
          <p class="mt-3 text-ink-muted">利用しているオープンソースプロジェクトへ改善を還元しています。</p>
        </div>
        <a class="btn btn-ghost max-sm:hidden" href="/oss">すべて見る</a>
      </div>
      <div class="mt-10 grid grid-cols-3 gap-5 max-lg:grid-cols-2 max-sm:grid-cols-1">
        {topOss.map((oss) => (<OssCard oss={oss} />))}
      </div>
      <div class="reveal mt-8 sm:hidden">
        <a class="btn btn-ghost" href="/oss">すべて見る</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-[clamp(4rem,9vw,7rem)]">
    <div class="container-x">
      <div class="reveal relative overflow-hidden rounded-[var(--radius-xl2)] border border-line bg-surface-subtle px-8 py-16 text-center max-sm:px-5">
        <span class="pointer-events-none absolute left-0 top-0 h-full w-[3px] bg-brand" aria-hidden="true"></span>
        <p class="eyebrow">Contact</p>
        <h2 class="mt-4 text-[clamp(1.5rem,3.4vw,2.2rem)] font-bold text-ink">プロジェクトのご相談はお気軽に</h2>
        <p class="mx-auto mt-3 max-w-xl text-ink-muted">
          「こんなことはできる?」という段階でも大丈夫です。まずはお話をお聞かせください。
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="btn btn-primary" href={site.contactFormUrl} target="_blank" rel="noopener">お問い合わせフォーム</a>
          <a class="btn btn-ghost" href="/contact">お問い合わせ方法</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
