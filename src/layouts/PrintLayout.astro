---
// パンフレット専用レイアウト。ナビ・フッター・テーマ切替を持たず、常にライトで印刷する。
import '../styles/global.css';
import '../styles/print.css';
import { site, company } from '../data/site';

interface Props {
  title?: string;
}

const { title = '会社紹介パンフレット' } = Astro.props;
const pageTitle = `${title} | ${site.brand}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>
    <meta name="description" content={`${site.name}の会社紹介パンフレット（印刷用）。`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- 本文用 Inter / 英字・数字用 JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="antialiased">
    <div class="pamphlet-toolbar no-print">
      <button type="button" class="btn btn-primary" onclick="window.print()">
        {company.name} パンフレットを印刷 / PDFとして保存
      </button>
      <span>ブラウザの印刷画面で「PDFに保存」を選ぶと、配布用PDFになります。</span>
    </div>

    <div class="pamphlet">
      <slot />
    </div>
  </body>
</html>
